BRLIA_ENV=example
BRLIA_LOG_LEVEL=info
BRLIA_TRACE_ID_HEADER=X-Trace-Id

BRLIA_DEPLOY_MODE=sidecar
BRLIA_POOL_TICK_MS=1
BRLIA_UDS_PATH=/var/run/brlia/pool.sock
BRLIA_POOL_QUEUE_DEPTH=65536
BRLIA_POOL_WATERMARK_MS=5
BRLIA_POOL_MAX_OPS_PER_WINDOW=4096
BRLIA_POOL_CPU_AFFINITY=2,3
BRLIA_WAL_PATH=/var/lib/brlia/pool.wal
BRLIA_DEGRADED_BUFFER_SECONDS=60

BRLIA_PG_HOST=postgres
BRLIA_PG_PORT=5432
BRLIA_PG_DB=brlia
BRLIA_PG_USER=brlia
BRLIA_PG_PASSWORD=change-me

BRLIA_KAFKA_BOOTSTRAP=redpanda:9092
BRLIA_REDIS_URL=redis://redis:6379/0

BRLIA_CONTROL_SOCKET=/var/run/brlia/control.sock
BRLIA_MTLS_ENABLED=true
BRLIA_SPIFFE_TRUST_DOMAIN=brlia.local

BRLIA_TREASURY_LIQUIDITY_CEILING_MINOR=10000000000
